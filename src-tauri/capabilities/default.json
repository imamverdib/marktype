{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the MarkType window needs: local Markdown file access, native dialogs, and enough window control to drive its own title bar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-start-dragging",

    "dialog:default",
    "os:default",
    "opener:default",

    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-copy-file",
    {
      "identifier": "fs:scope",
      "allow": [
        "$HOME/**",
        "/Volumes/**",
        "/private/tmp/**",
        "/tmp/**"
      ],
      "deny": [
        "$HOME/.ssh/**",
        "$HOME/.aws/**",
        "$HOME/.gnupg/**",
        "$HOME/Library/Keychains/**"
      ]
    }
  ]
}
