{
  "name": "marktype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MarkType — a fast, minimalist Typora-inspired Markdown editor for macOS",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsx scripts/check-markdown.ts",
    "check:markdown": "tsx scripts/check-markdown.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check:extension": "tsc --noEmit -p extension",
    "ext:build": "node extension/build.mjs",
    "ext:watch": "node extension/build.mjs --watch",
    "ext:package": "cd extension && node build.mjs --production && vsce package --no-dependencies --allow-missing-repository",
    "ext:publish": "cd extension && node build.mjs --production && vsce package --no-dependencies --allow-missing-repository && ovsx publish marktype-*.vsix"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-code-block-lowlight": "^3.30.2",
    "@tiptap/extension-highlight": "^3.30.2",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-list": "^3.30.2",
    "@tiptap/extension-mathematics": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/extensions": "^3.30.2",
    "@tiptap/markdown": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.549.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "^1.134.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "ovsx": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
